#!/usr/bin/env bash
# SessionStart hook for the dotbubl plugin.
# Injects the using-dotbubl skill as always-on context, since plugins have
# no native CLAUDE.md-equivalent for "always active" instructions.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_dotbubl_content=$(cat "${PLUGIN_ROOT}/skills/using-dotbubl/SKILL.md" 2>&1 || echo "Error reading using-dotbubl skill")

# Escape string for JSON embedding using bash parameter substitution
# (single C-level pass per replacement, no external processes).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped=$(escape_for_json "$using_dotbubl_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have dotbubl.\n\n**Below is the full content of your 'dotbubl:using-dotbubl' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${escaped}\n</EXTREMELY_IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"

exit 0
